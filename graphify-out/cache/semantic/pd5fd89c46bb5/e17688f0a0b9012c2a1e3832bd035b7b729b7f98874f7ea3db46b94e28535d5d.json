{"nodes": [{"id": "_claude_skills_cogpunk_dev_skill_cogpunk_dev_skill", "label": "cogpunk-dev Skill (Operating Manual)", "file_type": "document", "source_file": ".claude/skills/cogpunk-dev/SKILL.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_cogpunk_dev_skill_d0_no_crashes", "label": "D0 No Crashes Guaranteed", "file_type": "rationale", "source_file": ".claude/skills/cogpunk-dev/SKILL.md", "source_location": "L33", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Top priority directive; wins every conflict. A safer version is always chosen over a faster/prettier one. Risks checked against decompiled vanilla limits."}, {"id": "_claude_skills_cogpunk_dev_skill_d1_optimization", "label": "D1 Optimization", "file_type": "rationale", "source_file": ".claude/skills/cogpunk-dev/SKILL.md", "source_location": "L74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Zero heap allocations in hot paths (AI, Update, Draw); visuals client-only; netUpdate only on change; boss projectiles capped at 100."}, {"id": "_claude_skills_cogpunk_dev_skill_d2_coop_compatibility", "label": "D2 Co-op Compatibility", "file_type": "rationale", "source_file": ".claude/skills/cogpunk-dev/SKILL.md", "source_location": "L92", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Server decides NPC/world/random outcomes; player projectiles owner-only; ai[] synced, localAI not; tested SP, host+client, dedicated."}, {"id": "_claude_skills_cogpunk_dev_skill_d3_balance", "label": "D3 Balance", "file_type": "rationale", "source_file": ".claude/skills/cogpunk-dev/SKILL.md", "source_location": "L120", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every combat stat anchored to a same-tier vanilla item within +/-15% effective DPS (up to +25% with written trade-off); 4% base crit rule (2026-10-23)."}, {"id": "_claude_skills_cogpunk_dev_skill_d4_pixel_art", "label": "D4 Pixel Art", "file_type": "rationale", "source_file": ".claude/skills/cogpunk-dev/SKILL.md", "source_location": "L157", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Draw 1x, export 2x nearest-neighbor, palette-locked, top-left light, ramp outlines, no semi-transparent pixels; color caps items 16 / enemies 32 / bosses 48."}, {"id": "_claude_skills_cogpunk_dev_skill_d5_visual_proof", "label": "D5 Visual Proof (GIF)", "file_type": "rationale", "source_file": ".claude/skills/cogpunk-dev/SKILL.md", "source_location": "L181", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Anything that moves needs a GIF built from frames or an offline simulation using real sprites and constants; in-game capture is optional; must be self-reviewed."}, {"id": "_claude_skills_cogpunk_dev_skill_vanilla_limits", "label": "Vanilla Engine Limits Table", "file_type": "concept", "source_file": ".claude/skills/cogpunk-dev/SKILL.md", "source_location": "L37", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "maxNPCs 200, maxProjectiles 1000 (overwrites oldest), maxDust 6000, maxItems 400, maxGore 600, maxPlayers 255; verified by decompiling tModLoader v2026.08.3.0."}, {"id": "_claude_skills_cogpunk_dev_skill_safespawn", "label": "SafeSpawn (Core/Safety)", "file_type": "concept", "source_file": ".claude/skills/cogpunk-dev/SKILL.md", "source_location": "L56", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TryNewNPC/TryNewProjectile/TryNewDust/TryNewItem validate type ids and NaN, refuse instead of overwriting, keep reserve slots for vanilla (100 projectiles, 20 NPCs)."}, {"id": "_claude_skills_cogpunk_dev_skill_safelog", "label": "SafeLog (rate-limited logging)", "file_type": "concept", "source_file": ".claude/skills/cogpunk-dev/SKILL.md", "source_location": "L61", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each key reported at most 3 times to prevent console loops; deferred formatting via Warn(key, format, arg)."}, {"id": "_claude_skills_cogpunk_dev_skill_tilesafety", "label": "TileSafety", "file_type": "concept", "source_file": ".claude/skills/cogpunk-dev/SKILL.md", "source_location": "L57", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_cogpunk_dev_skill_mathsafety", "label": "MathSafety", "file_type": "concept", "source_file": ".claude/skills/cogpunk-dev/SKILL.md", "source_location": "L60", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_cogpunk_dev_skill_cogpunkpacket", "label": "CogpunkPacket", "file_type": "concept", "source_file": ".claude/skills/cogpunk-dev/SKILL.md", "source_location": "L62", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_cogpunk_dev_skill_packetregistry", "label": "PacketRegistry", "file_type": "concept", "source_file": ".claude/skills/cogpunk-dev/SKILL.md", "source_location": "L62", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Byte packet id (<=256 types); catches exceptions and drops malformed packets."}, {"id": "_claude_skills_cogpunk_dev_skill_safegenpass", "label": "SafeGenPass", "file_type": "concept", "source_file": ".claude/skills/cogpunk-dev/SKILL.md", "source_location": "L63", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Catches exceptions so world creation continues."}, {"id": "_claude_skills_cogpunk_dev_skill_genpassutils", "label": "GenPassUtils (InsertAfter/Replace)", "file_type": "concept", "source_file": ".claude/skills/cogpunk-dev/SKILL.md", "source_location": "L63", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_cogpunk_dev_skill_worldflagsystem", "label": "WorldFlagSystem", "file_type": "concept", "source_file": ".claude/skills/cogpunk-dev/SKILL.md", "source_location": "L106", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Saves flags by name (never numeric id) and syncs on WorldData."}, {"id": "_claude_skills_cogpunk_dev_skill_crossmod", "label": "CrossMod.TryCall", "file_type": "concept", "source_file": ".claude/skills/cogpunk-dev/SKILL.md", "source_location": "L68", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_cogpunk_dev_skill_core_templates", "label": "Core/Templates Bases (CogpunkItem/NPC/Projectile/Tile/Wall/Buff)", "file_type": "concept", "source_file": ".claude/skills/cogpunk-dev/SKILL.md", "source_location": "L65", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Missing-texture fallback (TextureFallback) means missing art never blocks loading."}, {"id": "_claude_skills_cogpunk_dev_skill_statemachinenpc", "label": "StateMachineNPC Template", "file_type": "concept", "source_file": ".claude/skills/cogpunk-dev/SKILL.md", "source_location": "L273", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Owns ai[0] state and ai[1] timer, seals AI(), recovers from NaN; ChangeState ignored on MP clients and syncs only on change."}, {"id": "_claude_skills_cogpunk_dev_skill_sceneoverlayregistry", "label": "SceneOverlayRegistry (Core/Hooks)", "file_type": "concept", "source_file": ".claude/skills/cogpunk-dev/SKILL.md", "source_location": "L248", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The single reflection touch in the codebase, isolated in Core/Hooks for the 1.4.5 port."}, {"id": "_claude_skills_cogpunk_dev_skill_bosstitlesystem", "label": "BossTitleSystem", "file_type": "concept", "source_file": ".claude/skills/cogpunk-dev/SKILL.md", "source_location": "L314", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_cogpunk_dev_skill_biometitlesystem", "label": "BiomeTitleSystem", "file_type": "concept", "source_file": ".claude/skills/cogpunk-dev/SKILL.md", "source_location": "L322", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_cogpunk_dev_skill_animatedequip", "label": "AnimatedEquip", "file_type": "concept", "source_file": ".claude/skills/cogpunk-dev/SKILL.md", "source_location": "L333", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_cogpunk_dev_skill_core_content_architecture", "label": "Core/Content Slice Architecture", "file_type": "rationale", "source_file": ".claude/skills/cogpunk-dev/SKILL.md", "source_location": "L244", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen 2026-10-20 after comparing Calamity (type-based), Starlight River (Core + type-based Content) and Spirit Reforged (feature-based). Core is engine with no content; Content/<Slice>/ per feature; slices never reach into each other."}, {"id": "_claude_skills_cogpunk_dev_skill_mechanistdamage", "label": "MechanistDamage DamageClass", "file_type": "concept", "source_file": ".claude/skills/cogpunk-dev/SKILL.md", "source_location": "L260", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_cogpunk_dev_skill_pressureplayer", "label": "PressurePlayer (Steam Pressure ModPlayer)", "file_type": "concept", "source_file": ".claude/skills/cogpunk-dev/SKILL.md", "source_location": "L261", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_cogpunk_dev_skill_vent_keybind", "label": "Vent Keybind", "file_type": "concept", "source_file": ".claude/skills/cogpunk-dev/SKILL.md", "source_location": "L262", "source_url"