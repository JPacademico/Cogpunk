# Português (Brasil). Mantenha as mesmas chaves do en-US_Mods.Cogpunk.hjson.

Configs: {
	CogpunkClientConfig: {
		DisplayName: Cogpunk: Configurações do Cliente

		Headers: {
			Visuals: Visual
		}

		ScreenShake: {
			Label: Tremor de tela
			Tooltip: Tremor da câmera causado por explosões, chefes e armas pesadas.
		}

		EffectDensity: {
			Label: Densidade de efeitos
			Tooltip: Quantidade de partículas opcionais de vapor, faíscas e fumaça. Diminua se o jogo travar.
		}

		ReduceFlashing: {
			Label: Reduzir clarões
			Tooltip: Suaviza clarões fortes e efeitos piscantes.
		}
	}
}

Items: {
	RustedScrap: {
		DisplayName: Sucata Enferrujada
		Tooltip: Lixo compactado. Algo útil ainda pode estar enterrado aí dentro.
	}

	RustedCog: {
		DisplayName: Engrenagem Enferrujada
		Tooltip: Corroída pela ferrugem, mas ainda quer girar.
	}

	RustedMetal: {
		DisplayName: Metal Enferrujado
		Tooltip: Uma chapa rebitada e rasgada. Metal bom por baixo da ferrugem.
	}

	Scrappybot: {
		DisplayName: Scrappybot
		Tooltip: Invoca o Scrappybot, um robozinho enferrujado que desliga para recarregar
	}

	ScrapBomb: {
		DisplayName: Bomba de Sucata
		Tooltip:
			'''
			Explode ao impacto, causando {0} de dano de explosão em um raio de {1} blocos
			Um acerto direto causa o dano total mais a explosão
			Não destrói blocos
			'''
	}

	ScrapHelmet: {
		DisplayName: Capacete de Sucata
		Tooltip:
			'''
			Mostra o minério mais valioso ao seu redor
			Uma panela amassada com um óculos aparafusado. A engrenagem ainda gira.
			'''
		SetBonus:
			'''
			{0}% de velocidade de movimento
			Em movimento, lança uma engrenagem quicante a cada {1} segundos ({2} de dano)
			Ela voa no inimigo mais próximo, ou para trás de você se não houver nenhum
			'''
	}

	ScrapBreastplate: {
		DisplayName: Peitoral de Sucata
		Tooltip:
			'''
			{0}% de dano aumentado
			Rebitado com o que o monte de sucata tinha para dar
			'''
	}

	ScrapLeggings: {
		DisplayName: Perneiras de Sucata
		Tooltip:
			'''
			{0}% de dano de queda reduzido
			Enferrujadas, mas ainda com mola
			'''
	}

	PolishedMetal: {
		DisplayName: Metal Polido
		Tooltip: Chapas soldadas e remendadas. Duras demais para a maioria das picaretas.
	}

	ScrappyTrunk: {
		DisplayName: Baú de Sucata
		Tooltip: ""
	}

	Junkbait: {
		DisplayName: Isca de Sucata
		Tooltip:
			'''
			Uma bola de sucata engraxada com um robozinho chacoalhando dentro
			Use no Ferro-Velho para atrair o Trash-Tr0m
			'''
	}

	LostKey: {
		DisplayName: Chave Perdida
		Tooltip:
			'''
			Abre o Esconderijo do Ferro-Velho
			'Alguém já mastigou isto'
			'''
	}

	Screwdriver: {
		DisplayName: Chave de Fenda
		Tooltip:
			'''
			Acerta na estocada e de novo na volta
			{0}% de dano a mais contra inimigos mecânicos
			'Aperta pra direita, solta pra esquerda, espeta pra frente'
			'''
	}

	ScrappyWand: {
		DisplayName: Varinha de Sucata
		Tooltip:
			'''
			Dispara uma rajada de {0} faíscas
			Só a primeira vai para onde você mira
			'''
	}

	ScrappyBow: {
		DisplayName: Arco de Sucata
		Tooltip:
			'''
			Solta de {0} a {1} flechas pelo preço de uma
			Só a primeira flecha voa certeira
			'''
	}

	MiceBot: {
		DisplayName: Rato-Robô
		Tooltip:
			'''
			Invoca um ratinho de corda para lutar por você
			Ocupa meio espaço de lacaio
			Cava através de paredes e pisos finos para alcançar inimigos
			'Dê corda e solte'
			'''
	}

	TrashTr0mBag: {
		DisplayName: Bolsa do Tesouro ({$Mods.Cogpunk.NPCs.TrashTr0m.DisplayName})
		Tooltip: "{$CommonItemTooltip.RightClickToOpen}"
	}

	Tetanus: {
		DisplayName: Tétano
		Tooltip:
			'''
			Uma estocada rápida que acerta na ida e de novo na volta, para onde você mirar
			Segure o botão direito para recolher e carregar: +{0}% de dano a cada meio segundo, até +{1}%
			A investida carregada também acerta na ida e na volta
			Causa Tétano: o alvo sofre {2}% a mais de dano
			'Cuidado com a ferrugem'
			'''
	}

	ScrapLauncher: {
		DisplayName: Lança-Sucata
		Tooltip:
			'''
			Usa balas como munição, mas dispara sucata mastigada que voa reta pela tela inteira
			Botão direito para arremessar uma grande bola de sucata que quica uma vez
			'Abre a boca'
			'''
	}

	Scrapmancer: {
		DisplayName: Sucatamante
		Tooltip:
			'''
			Golpeia o chão e lança uma onda de sucata na direção do cursor
			Ela percorre uma tela inteira, atravessa todos os inimigos e os arremessa longe
			Precisa de chão abaixo de você
			'''
	}

	Tr0mheadStaff: {
		DisplayName: Tr0mhead
		Tooltip:
			'''
			Invoca uma sentinela Tr0mhead que suga e mastiga os inimigos próximos
			Suga por até {0} segundos e depois solta vapor por {1} segundos
			'Ainda está com fome'
			'''
	}

	PolisherSchematic: {
		DisplayName: Esquema do Polidor
		Tooltip:
			'''
			Permite construir um Polidor de Ferrugem numa bigorna
			Não é consumido
			'A maior parte das instruções são manchas de graxa'
			'''
	}

	RustPolisher: {
		DisplayName: Polidor de Ferrugem
		Tooltip: Usado para polir metal enferrujado e fabricar a armadura Polida e Recipientes de Latão
	}

	MysteriousMap: {
		DisplayName: Mapa Misterioso
		Tooltip:
			'''
			Enquanto estiver na mão, uma seta aponta o caminho para algo escondido neste mundo
			'A tinta ainda está fresca'
			'''
	}

	TarDrop: {
		DisplayName: Gota de Piche
		Tooltip: Uma bolota do piche do Ferro-Velho. Ainda está morna.
	}

	CondensedTar: {
		DisplayName: Piche Condensado
		Tooltip: Quatro gotas de piche, fervidas até manterem a forma.
	}

	PolishedHelmet: {
		DisplayName: Elmo Polido
		Tooltip:
			'''
			{0}% de chance de acerto crítico de mecanista
			Uma tampa de caldeira lustrada com um manômetro no topo
			'''
		SetBonus: Armas de mecanista usam {0}% menos vapor
	}

	PolishedChestplate: {
		DisplayName: Peitoral Polido
		Tooltip:
			'''
			Aumenta o vapor máximo em {0}
			Uma caldeirinha vai nas costas
			'''
	}

	PolishedPants: {
		DisplayName: Calças Polidas
		Tooltip:
			'''
			{0}% de velocidade de movimento
			Joelhos de pistão, recém-engraxados
			'''
	}

	TrapperChain: {
		DisplayName: Corrente do Caçador
		Tooltip:
			'''
			Arremessa uma armadilha de urso numa corrente que morde todo inimigo pego entre as mandíbulas
			Pronta para outro arremesso assim que a armadilha volta
			'Ainda tem cheiro de selva'
			'''
	}

	GlassContainer: {
		DisplayName: Recipiente de Vidro
		Tooltip:
			'''
			Aumenta o vapor máximo em {0}
			Só um recipiente de vapor pode ser usado
			'Manuseie com cuidado'
			'''
	}

	BrassContainer: {
		DisplayName: Recipiente de Latão
		Tooltip:
			'''
			Aumenta o vapor máximo em {0}
			{1}% de dano de mecanista
			Só um recipiente de vapor pode ser usado
			'''
	}

	AlarmHead: {
		DisplayName: Cabeça de Alarme
		Tooltip:
			'''
			Invoca um Alarmobô que segue você e nunca para de tocar
			Todo jogador a até {2} blocos dele ganha {0}% de velocidade de movimento e {1}% de velocidade de ataque
			Vários Alarmobôs se acumulam
			'Ele só queria avisar alguém'
			'''
	}

	CogpunkerManual: {
		DisplayName: Manual do Cogpunker
		Tooltip:
			'''
			Aumenta o vapor máximo em {0} permanentemente
			Ensina a investida a vapor: uma rajada de vapor que projéteis atravessam
			Custa {1} de vapor e fica pronta de novo após {2} segundos. Toque duas vezes para a esquerda ou direita, ou use a tecla abaixo
			Inimigos em que você investe ainda acertam você
			Só pode ser lido uma vez por personagem
			'''
		Learned: Investida a vapor aprendida!
		AlreadyRead: Você já leu este manual
		DashKey: "Tecla da investida a vapor: {0}"
		DashKeyUnbound: sem tecla (defina em Controles)
	}

	JaegerHelmet: {
		DisplayName: Capacete de Jaeger
		Tooltip:
			'''
			{0}% de dano corpo a corpo
			O visor ainda brilha
			'''
		SetBonus:
			'''
			Imune a repulsão e {0}% de repulsão a mais
			Inimigos em que você encosta sofrem {1} de dano corpo a corpo
			{2}% de velocidade de movimento a menos
			'''
	}

	JaegerChestplate: {
		DisplayName: Peitoral de Jaeger
		Tooltip:
			'''
			{0}% menos dano ao encostar em inimigos
			O reator ainda está quente
			'''
	}

	JaegerGreaves: {
		DisplayName: Grevas de Jaeger
		Tooltip:
			'''
			Pulo mais alto
			{0}% de chance de acerto crítico corpo a corpo
			'''
	}

	PolishedCog: {
		DisplayName: Engrenagem Polida
		Tooltip:
			'''
			{0}% de velocidade de movimento enquanto superaquecido
			'Sem ferrugem e com os dentes afiados: gira mais rápido quando a caldeira estoura'
			'''
	}

	ChickenSnapper: {
		DisplayName: Pinça Pega-Frango
		Tooltip:
			'''
			{0}% de chance de acerto crítico corpo a corpo
			{1}% de velocidade corpo a corpo
			'Ela ainda se fecha sozinha quando algo com penas passa por perto'
			'''
	}

	Scrapworm: {
		DisplayName: Minhoca de Sucata
		Tooltip:
			'''
			Use como isca de pesca no piche do Ferro-Velho...
			Nada mais vai morder
			'''
	}

	TarTyrantBag: {
		DisplayName: Bolsa do Tesouro ({$Mods.Cogpunk.NPCs.TarTyrant.DisplayName})
		Tooltip: "{$CommonItemTooltip.RightClickToOpen}"
	}

	SereneTear: {
		DisplayName: Gota Serena
		Tooltip:
			'''
			Os custos de mana são pagos primeiro com vapor, e com mana quando o vapor acaba
			Imunidade a Superaquecido
			{0}% de aumento na regeneração de vapor
			'Não caiu de olho nenhum. Foi o piche que a chorou'
			'''
	}

	TyrantSkull: {
		DisplayName: Crânio do Tirano
		Tooltip:
			'''
			{0}% de aumento no dano mágico
			{1}% de chance de acerto crítico mágico
			'''
		SetBonus:
			'''
			A cada {0} segundos uma garra de piche irrompe do chão sob o inimigo mais próximo
			A garra causa {1} de dano mágico a cada inimigo que pegar
			'''
	}

	TyrantCape: {
		DisplayName: Capa do Tirano
		Tooltip:
			'''
			{0}% de redução no custo de mana e de vapor
			'Ainda molhada'
			'''
	}

	TyrantSandals: {
		DisplayName: Sandálias do Tirano
		Tooltip:
			'''
			{0}% de aumento na velocidade de movimento e na altura do pulo
			O dobro quando o vapor acaba
			'''
	}
}

Buffs: {
	ScrappybotBuff: {
		DisplayName: Scrappybot
		Description: Um robozinho enferrujado está seguindo você
	}

	MiceBotBuff: {
		DisplayName: Rato-Robô
		Description: Um ratinho de corda está mordendo seus inimigos
	}

	TarPlague: {
		DisplayName: Praga do Piche
		Description: O piche fervente está corroendo você. Saia daí!
	}

	TetanusDebuff: {
		DisplayName: Tétano
		Description: Sofrendo 10% a mais de dano
	}

	Overheat: {
		DisplayName: Superaquecido
		Description: Sua caldeira está soltando vapor! Sem itens, e você não consegue parar de se mover até o vapor encher de novo
	}

	AlarmoboBuff: {
		DisplayName: Alarmobô
		Description: "{0} Alarmobô por perto: +{1}% de velocidade de movimento, +{2}% de velocidade de ataque"
	}
}

NPCs: {
	TrashTr0m: {
		DisplayName: Trash-Tr0m
		Epithet: Colosso do Ferro-Velho
		Bestiary: A metade de cima de um titã de obras, arrancada na cintura e soldada de novo com o que o Ferro-Velho tinha. Arrasta-se atrás de tudo que se mexe, golpeia o chão até fazê-lo ondular e engole o que não consegue pegar. Dorme sob a sucata, guardando um esconderijo que já não consegue abrir: engoliu a chave há muito tempo.
		CacheGuarded: O esconderijo não cede. Algo ainda o protege...
		KeyDropped: Uma chave toda mastigada cai dos destroços...
		CacheLocked: O baú está bem trancado. A Chave Perdida do Trash-Tr0m o abre.
	}

	RustCollector: {
		DisplayName: Coletor de Ferrugem
		Bestiary: Uma lixeira de sucata sobre dois roletes que nunca parou de trabalhar. Avança contra qualquer coisa que possa ser ferrugem, e acha que tudo pode ser ferrugem. Não consegue subir, mas nunca para de acelerar.
	}

	Trapper: {
		DisplayName: Caçador
		Bestiary: Meio goblin, meio engrenagem, todo caçador. Parafusou em si mesmo um braço de latão e um olho de lente e foi para a selva com um saco de bolas de espinhos. Nunca deixa a presa chegar perto: corre, se vira e semeia o chão de espinhos.
	}

	LivingTar: {
		DisplayName: Piche Vivo
		Bestiary: Piche da piscina do Ferro-Velho que rastejou para fora sozinho. Pula como qualquer geleia, e a cada pouso arremessa uma bolota quente de si mesmo em quem estiver perseguindo.
	}

	RogueMiceBot: {
		DisplayName: Rato-Robô Renegado
		Bestiary: Um rato de corda que soltou a chave e nunca mais voltou. O Exército Mecânico dá corda neles às dúzias; eles correm mais rápido do que você anda e saltam com os dentes de aço à mostra.
	}

	Boombot: {
		DisplayName: Bombobô
		Bestiary: Uma bomba com pernas e uma única tarefa. Apita mais rápido quanto mais perto chega, e explode no instante em que encosta em você. Se for abatido antes, só faz um estalo.
	}

	AnnoyOTron: {
		DisplayName: Alarmobô
		Bestiary: Uma caixa de alarme sobre esteiras, com um giroflex de emergência no lugar da cabeça. Nunca luta. Segue o exército gritando, e toda máquina que o ouve fica metade mais rápida.
	}

	Jaeger: {
		DisplayName: Jaeger
		Bestiary: A fortaleza ambulante do Exército Mecânico, seis vezes mais alta que uma pessoa e blindada como uma caldeira. Marcha devagar e nunca para, e arremessa longe o que estiver no caminho. Só entra em campo quando a batalha já está pela metade.
	}

	TarTyrant: {
		DisplayName: Tirano de Piche
		Epithet: Monarca do Lodaçal
		Bestiary: O poço de piche do Ferro-Velho é mais velho que o Ferro-Velho. Algo enorme se afogou nele há muito tempo, e o piche guardou seus ossos e aprendeu a movê-los. Ele usa o velho crânio como rosto, arremessa os próprios ossos em quem chega perto, e cada ferida que leva solta piche que sai rastejando sozinho. Só uma minhoca feita de sucata é tentadora o bastante para pescá-lo.
	}

	TarTyrantBubble: {
		DisplayName: Bolha de Piche
	}

	ScrapwormCritter: {
		DisplayName: Minhoca de Sucata
		Bestiary: Uma minhoca que comeu tanta sucata enterrada que virou sucata. É inofensiva e rara, e algo no piche do Ferro-Velho adoraria comê-la.
	}

	PuxaFrango: {
		DisplayName: Puxa-frango
		Bestiary: Uma máquina corcunda e rangente que espreita as cavernas sobre pernas finas. Antes ela guardava um galinheiro; agora não guarda nada e agarra tudo. Quando as garras se abrem, ela vai dar o bote, e puxa para perto o que pegar.
	}
}

