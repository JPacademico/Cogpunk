	HawkEye: {
		DisplayName: Olho de Falcão
		Tooltip:
			'''
			{0}% de chance de acerto crítico à distância
			'Escolhe um alvo do alto de uma duna'
			'''
	}

	SheriffBadge: {
		DisplayName: Distintivo do Xerife
		Tooltip:
			'''
			Nomeia uma estrela de xerife que voa sobre sua cabeça e luta por você
			Cada estrela ocupa um espaço de lacaio
			As estrelas voam até seus inimigos e voltam, acertando tudo no caminho
			'A lei é quem estiver com o distintivo'
			'''
	}

	SheriffsRevolver: {
		DisplayName: Revólver do Xerife
		Tooltip:
			'''
			Dispara uma bala de latão veloz que ricocheteia uma vez numa parede, rumo ao inimigo mais próximo à vista
			Um ricochete acerta com 50% a mais de dano
			Usa balas: seja qual for a bala, dispara sua própria munição de latão somando o dano da bala
			Guarda {0} balas e leva {1} segundos para recarregar quando elas acabam, mesmo guardado no coldre
			Botão direito para disparar todas as balas que restam em um terço de segundo por {2} de vapor
			'Nesta cidade, a lei atira primeiro'
			'''
		Rounds: "{0}/{1} balas no tambor"
	}

	SheriffsKey: {
		DisplayName: Chave do Xerife
