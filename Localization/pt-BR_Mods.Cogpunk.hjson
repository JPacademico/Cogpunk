	RedCloth: {
		DisplayName: Pano Vermelho
		Tooltip:
			'''
			O próximo inimigo que te tocar passa direto: nenhum dano, depois {1} segundos de imunidade
			Recarrega por {0} segundos depois de cada esquiva
			'Todo touro investe contra o pano, nunca contra o toureiro'
			'''
		Ole: Olé!
	}

	LawHat: {
		DisplayName: Chapéu da Lei
		Tooltip:
			'''
			{0}% de chance de acerto crítico aumentada para armas que usam balas
			'A estrela ainda brilha, mesmo sem a cidade'
			'''
	}

	BrassHelmet: {
		DisplayName: Elmo de Latão
		Tooltip:
			'''
			{0}% de chance de acerto crítico mecanista aumentada
			Um capacete de escafandro de caldeireiro, com uma escotilha por viseira
			'''
		SetBonus: O dano recebido enquanto superaquecido é reduzido em {0}%
	}

	BrassChestplate: {
		DisplayName: Peitoral de Latão
		Tooltip:
			'''
			{0}% de dano mecanista aumentado
			Aumenta o vapor máximo em {1}
			'''
	}

	BrassGreaves: {
		DisplayName: Grevas de Latão
		Tooltip: "{0}% de velocidade de ataque mecanista aumentada"
	}

	CursedTrainWhistle: {
		DisplayName: Apito do Trem Amaldiçoado
		Tooltip:
			'''
			Invoca um pequeno trem fantasma para lutar por você
			Cada novo sopro engata mais um vagão em vez disso
			Ele investe através dos inimigos e volta até você antes de investir de novo
			Cada vagão que acerta o mesmo inimigo numa investida causa 12% menos que o anterior
			'''
	}

	Firesaw: {
		DisplayName: Serra de Fogo
		Tooltip:
			'''
			Brande como uma espada grande: cada golpe volta pelo outro lado
			Botão direito para golpear com a lâmina em chamas: dois blocos a mais de alcance, deixa os inimigos Em Chamas! por {1} segundos, {0} de vapor por golpe
			'Puxe a corda, bombeie o combustível, cuidado com os dedos'
			'''
	}

	JadeStaff: {
		DisplayName: Cajado de Jade
		Tooltip:
			'''
			Conjura um raio ondulante de magia de jade que persegue os inimigos transformados em jade
			Cada acerto lança uma maldição de jade: ataques {0}% mais lentos por acúmulo
			Com {1} acúmulos o inimigo vira jade por {2} segundos, e depois não pode ser amaldiçoado por {3} segundos
			Chefes e minichefes precisam de {4} acúmulos, e viram jade no máximo {5} vezes por luta
			'''
	}

	DiamondCutter: {
		DisplayName: Cortador de Diamante
		Tooltip:
			'''
			Dispara um feixe de diamante preciso e instantâneo que atravessa até {0} inimigos
			Ignora {1}% da defesa inimiga
			Não usa munição
			'''
	}

	BarrelGun: {
		DisplayName: Arma-Barril
		Tooltip:
			'''
			Arremessa peixes
			{0}% de chance de atordoar um inimigo comum
			Não pode acertar golpes críticos
			Na chuva ou debaixo da água: +{1}% de dano, e os peixes perseguem os inimigos
			'''
	}

	SteamInjector: {
		DisplayName: Injetor de Vapor
		Tooltip: "Clique com o botão direito para receber Injeção de Vapor: +{0} de vapor máximo e {1}% a menos de custo de vapor até morrer"
	}

	Koi: {
		DisplayName: Carpa Koi
		Tooltip: "'Só nada no lago de Coghaven'"
	}

	TheFirstHalf: {
		DisplayName: A Primeira Metade
		Tooltip:
			'''
			Metade do núcleo de uma máquina estranha
			'Deve ter uma gêmea em algum lugar'
			'''
	}

	TheSecondHalf: {
		DisplayName: A Segunda Metade
		Tooltip:
			'''
			A outra metade do núcleo de uma máquina estranha
			'Deve ter uma gêmea em algum lugar'
			'''
	}

	CombinatorBlueprint: {
		DisplayName: Planta do Combinador
		Tooltip:
			'''
			Projeto de uma máquina que funde duas armas em uma
			Junte com as duas metades numa Bigorna de Mithril
			'''
	}

	TheCombinator: {
		DisplayName: O Combinador
		Tooltip:
			'''
			Funde duas armas da mesma classe em uma
			Clique com o botão direito para abrir
			'''
	}

	PossessedCog: {
		DisplayName: Engrenagem Possuída
		Tooltip: Atravessa os inimigos moendo-os, em vez de ricochetear neles
	}

	PagodaChest: {
		DisplayName: Baú do Pagode
		Tooltip: ''
	}

	PagodaKey: {
		DisplayName: Chave do Pagode
		Tooltip: Destranca o Baú do Pagode Trancado no topo do pagode de Coghaven
	}

	JadeyBag: {
		DisplayName: Bolsa do Tesouro ({$Mods.Cogpunk.NPCs.Jadey.DisplayName})
		Tooltip: "{$CommonItemTooltip.RightClickToOpen}"
	}

	JadeShaperPendant: {
		DisplayName: Pingente da Molda-Jade
		Tooltip:
			'''
			Um golpe que mataria você o transforma numa estátua de jade por {0} segundos
			A estátua não sofre dano, mas os golpes ainda a empurram
			Recarrega por {1} minutos depois de salvar você
			'''
	}

	JadeIncense: {
		DisplayName: Incenso de Jade
		Tooltip:
			'''
			Queime-o dentro do Cofre de Jade de Coghaven para chamar Jadey
			'Ela nunca recusa uma visita que traz incenso'
			'''
	}

	JadeShaperWhip: {
		DisplayName: Chicote da Molda-Jade
		Tooltip:
			'''
			{0} de dano de marcação para invocações
			Suas invocações vão focar nos inimigos atingidos
			Causa {1}% a mais de dano a inimigos transformados em jade
			'''
	}

	JadeCursedGlaives: {
		DisplayName: Glaives Amaldiçoadas de Jade
		Tooltip:
			'''
			Cortes cruzados abrem um único arco largo de jade e lançam a maldição de jade no que cortam
			Clique direito para arremessar a glaive a até {0} blocos; ela volta à sua mão
			Cortes e arremessos causam {1}% a mais de dano a inimigos transformados em jade
			'''
	}

	FireworkCannon: {
		DisplayName: Canhão de Fogos
		Tooltip:
			'''
			Dispara fogos rápidos que explodem ao acertar, contra paredes ou após {0} blocos
			A explosão fere tudo ao redor e tem {1}% de chance de atordoar inimigos comuns por {2} segundo
			'''
	}

	JadeShaperManual: {
		DisplayName: Manual da Molda-Jade
		Tooltip:
			'''
			As anotações de Jadey sobre moldar jade viva
			Estude-o para guardar seu conhecimento
			'Certas artes só se aprendem, nunca se encontram'
			'''
	}

	ScrapManual: {
		DisplayName: Manual de Sucata
		Tooltip:
			'''
			As anotações de montagem engorduradas de Trash-Tr0m
			Estude-o para guardar seu conhecimento
			'Certas artes só se aprendem, nunca se encontram'
			'''
	}

	SheriffsLawBook: {
		DisplayName: Livro da Lei do Xerife
		Tooltip:
			'''
			O livro das velhas leis de Westworld do Condutor Amaldiçoado
			Estude-o para guardar seu conhecimento
			'Certas artes só se aprendem, nunca se encontram'
			'''
	}

	StickyPages: {
		DisplayName: Páginas Grudentas
		Tooltip:
			'''
			Páginas tiradas de dentro do Tirano de Piche, ainda legíveis
			Estude-as para guardar seu conhecimento
			'Certas artes só se aprendem, nunca se encontram'
			'''
	}

	JadeEyedKoi: {
		DisplayName: Carpa de Olhos de Jade
		Tooltip:
			'''
			Uma carpa koi fundida em ouro, com olhos de jade polido
			'Vale uma fortuna para o mercador certo'
			'''
	}

	Cakti: {
		DisplayName: Cak-ti
		Tooltip:
			'''
			Dispara espinhos finos de cacto que ficam presos nos inimigos por {0} segundos
			Quando um inimigo espetado morre, seus espinhos voam para todos os lados
			{1}% de chance de não consumir munição
			'Não dê um abraço'
			'''
	}

	IncenseMace: {
		DisplayName: Maça de Incenso
		Tooltip:
			'''
			Segure para girar o incensário e solte para arremessá-lo: arremessado, ele bate com o dobro da força
			Clique direito para espalhar uma aura de incenso ({4} de vapor): aliados a até {0} blocos ganham +{1}% de dano e de velocidade de ataque por {2} segundos
			Depois o incensário precisa de {3} segundos para reacender
			'Cheira a templo e bate como um sino'
			'''
	}

	JadeToken: {
		DisplayName: Ficha de Jade
		Tooltip:
			'''
			Invoca uma raposa espiritual de jade
			'Brilha suavemente'
			'''
	}

	AncientResearchBook: {
		DisplayName: Livro de Pesquisa Antigo
		Tooltip:
			'''
			Usado para construir uma Mesa de Pesquisa Antiga
			'O olho parece seguir você'
			'''
	}

	AncientResearchTable: {
		DisplayName: Mesa de Pesquisa Antiga
		Tooltip:
			'''
			Clique direito para pesquisar: gaste pontos de conhecimento em bônus permanentes e novas receitas
			O conhecimento vem das suas primeiras vezes: chefes, eventos, descobertas
			'''
	}

	TetanusShot: {
		DisplayName: Vacina Antitetânica
		Tooltip:
			'''
			Concede imunidade ao Tétano
			'Só uma picadinha'
			'''
	}

	BundleOfWands: {
		DisplayName: Feixe de Varinhas
		Tooltip:
			'''
			Dispara cinco raios de gemas diferentes de uma vez
			Cada um voa, acerta e empurra como o do seu cajado
			'''
	}

	BanditsDream: {
		DisplayName: Sonho do Bandido
		Tooltip:
			'''
			Dispara uma bala de latão veloz que ricocheteia uma vez numa parede, rumo ao inimigo mais próximo à vista
			Um ricochete acerta com 50% a mais de dano
			Usa balas: seja qual for a bala, dispara sua própria munição de latão somando o dano da bala
			Guarda {0} balas e leva {1} segundos para recarregar quando elas acabam (o tambor do Revólver do Xerife)
			Botão direito para um corte à frente com {2}x o dano, que derruba projéteis inimigos, por {3} de vapor: funciona no meio da recarga
			'O sonho de todo fora da lei: nunca ficar sem balas'
			'''
	}
	CogspringSword: {
		DisplayName: Espada Molamecânica
		Tooltip:
			'''
			Brande como um sabre: cada golpe volta pelo outro lado
			Segure o botão direito para dar corda: até {0} segundos para até {1}x de dano, solte para golpear de cima ({2} de vapor)
			Um golpe totalmente carregado que mata um inimigo desacelera o tempo
			'Cada engrenagem bem apertada, cada dente afiado'
			'''
	}
	SmokerBook: {
		DisplayName: Livro Fumegante
		Tooltip:
			'''
			Lança uma faixa veloz de fuligem a {0} blocos
			A fumaça atravessa todos os inimigos no caminho
			'Ninguém nunca leu estas páginas sem tossir'
			'''
	}
	FungimancerBag: {
		DisplayName: Bolsa de Tesouro (Fungimante)
		Tooltip: "{$CommonItemTooltip.RightClickToOpen}"
	}

	RainbowMushroom: {
		DisplayName: Cogumelo Arco-íris
		Tooltip:
			'''
			Invoca o Fungimante
			Só funciona num bioma de cogumelos brilhantes
			'Tem gosto de todas as cores ao mesmo tempo'
			'''
	}

	FungiManual: {
		DisplayName: Manual dos Fungos
		Tooltip:
			'''
			As anotações encharcadas do Fungimante sobre magia de cogumelos
			Estude-o para guardar seu conhecimento
			'Certas artes só se aprendem, nunca se encontram'
			'''
	}
}

