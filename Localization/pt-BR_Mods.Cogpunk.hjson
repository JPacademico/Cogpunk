	TarTyrantBag: {
		DisplayName: Bolsa do Tesouro ({$Mods.Cogpunk.NPCs.TarTyrant.DisplayName})
		Tooltip: "{$CommonItemTooltip.RightClickToOpen}"
	}

	SereneTear: {
		DisplayName: Gota Serena
		Tooltip:
			'''
			Os custos de mana são pagos primeiro com vapor, e com mana quando o vapor acaba
			Imunidade a Superaquecido
			{0}% de aumento na regeneração de vapor
			Armas de vapor usam mana quando o vapor acaba, a 2 de mana por vapor (com metade dos bônus de vapor)
			Gastar vapor ou mana impede os dois de recarregarem
			'Não caiu de olho nenhum. Foi o piche que a chorou'
			'''
	}

	TyrantSkull: {
		DisplayName: Crânio do Tirano
		Tooltip:
			'''
			{0}% de aumento no dano de invocação e mágico
			Aumenta em {1} o número máximo de lacaios
			'''
		SetBonus:
			'''
			A cada {0} segundos uma garra de piche irrompe do chão sob o inimigo mais próximo
			A garra causa {1} de dano mágico a cada inimigo que pegar
			{2}% de chance de acerto crítico de invocação e mágico
			A Praga do Piche que você inflige nos inimigos dura {3} segundos a mais
			'''
	}

	TyrantCape: {
		DisplayName: Capa do Tirano
		Tooltip:
			'''
			{0}% de aumento na velocidade dos chicotes
			{1}% de redução no custo de mana
			'Ainda molhada'
			'''
	}

	TyrantSandals: {
		DisplayName: Sandálias do Tirano
		Tooltip: Imunidade a dano de queda
	}

	Macuahuitl: {
		DisplayName: Macuahuitl
		Tooltip:
			'''
			Seu primeiro golpe em cada inimigo causa {0}x de dano ({1}x se for crítico)
			Usado para forjar uma lâmina mais forte
			'A obsidiana morde mais fundo na primeira vez'
			'''
	}

	MetalWrench: {
		DisplayName: Chave Inglesa de Metal
		Tooltip:
			'''
			{0}% a mais de dano contra inimigos mecânicos
			Botão direito para aparar por {4} de vapor: por {1} segundo, um ataque inimigo ricocheteia na chave e não causa nada
			Aparar prepara um contra-ataque: seu próximo golpe causa {3}x de dano
			Um contra-ataque num chefe ou mini-chefe desacelera o tempo por um instante
			O aparo leva {2} segundos para se recuperar
			'Todo problema parece um parafuso solto'
			'''
	}

	Tarmancer: {
		DisplayName: Pichemante
		Tooltip:
			'''
			Invoca uma geleia de piche que cospe bolotas de piche nos seus inimigos
			O piche os desacelera e os corrói
			'Isso nunca sai'
			'''
	}

	TarBoneStaff: {
		DisplayName: Cajado de Osso de Piche
		Tooltip:
			'''
			Lança um crânio de tirano lento que caça o inimigo mais próximo
			Ele morde e estoura, ferindo todos os inimigos ao redor
			'''
	}

	TarShower: {
		DisplayName: Ducha de Piche
		Tooltip:
			'''
			Usa gel como munição, mas borrifa piche que desacelera e corrói os inimigos
			Segure o botão direito para inchar uma bola de piche no bocal por {3} de vapor: até {1}% de dano em {0} segundos
			Carregada por completo, atravessa todos os inimigos e deixa {2} blocos de piche onde cai por {4} segundos
			'''
	}

	TarWhip: {
		DisplayName: Chicote de Piche
		Tooltip:
			'''
			{0} de dano de marcação para invocações
			Suas invocações vão focar nos inimigos atingidos
			Cobre os inimigos atingidos com a Praga do Piche por {1} segundos
			'''
	}

	RustedNail: {
		DisplayName: Prego Enferrujado
		Tooltip:
			'''
			Inimigos que tocam em você sofrem {0} de dano
			e pegam Tétano: {1}% a mais de dano recebido por {2} segundos
			'Tomou a vacina?'
			'''
	}

	SpringGloves: {
		DisplayName: Luvas de Mola
		Tooltip:
			'''
			Ataques ganham {0}% de dano e repulsão para cada ponto de vapor que usam
			Vale para armas de Mecanista, magias pagas com vapor e habilidades de arma a vapor
			'Dê corda e solte'
			'''
	}

