		Tooltip:
			'''
			O próximo inimigo que te tocar passa direto: nenhum dano, depois {1} segundos de imunidade
			Recarrega por {0} segundos depois de cada esquiva
			'Todo touro investe contra o pano, nunca contra o toureiro'
			'''
		Ole: Olé!
	}

	LawHat: {
		DisplayName: Chapéu da Lei
		Tooltip:
			'''
			{0}% de chance de acerto crítico aumentada para armas que usam balas
			'A estrela ainda brilha, mesmo sem a cidade'
			'''
	}

	BrassHelmet: {
		DisplayName: Elmo de Latão
		Tooltip:
			'''
			{0}% de chance de acerto crítico mecanista aumentada
			Um capacete de escafandro de caldeireiro, com uma escotilha por viseira
			'''
		SetBonus: O dano recebido enquanto superaquecido é reduzido em {0}%
	}

	BrassChestplate: {
		DisplayName: Peitoral de Latão
		Tooltip:
			'''
			{0}% de dano mecanista aumentado
			Aumenta o vapor máximo em {1}
			'''
	}

	BrassGreaves: {
		DisplayName: Grevas de Latão
		Tooltip: "{0}% de velocidade de ataque mecanista aumentada"
	}

	CursedTrainWhistle: {
		DisplayName: Apito do Trem Amaldiçoado
		Tooltip:
			'''
			Invoca um pequeno trem fantasma para lutar por você
			Cada novo sopro engata mais um vagão em vez disso
			Ele investe através dos inimigos e volta até você antes de investir de novo
			Cada vagão que acerta o mesmo inimigo numa investida causa 12% menos que o anterior
			'''
	}

	Firesaw: {
		DisplayName: Serra de Fogo
		Tooltip:
			'''
			Brande como uma espada grande: cada golpe volta pelo outro lado
			Botão direito para golpear com a lâmina em chamas: dois blocos a mais de alcance, deixa os inimigos Em Chamas! por {1} segundos, {0} de vapor por golpe
			'Puxe a corda, bombeie o combustível, cuidado com os dedos'
			'''
	}

	JadeStaff: {
		DisplayName: Cajado de Jade
		Tooltip:
			'''
			Conjura um raio ondulante de magia de jade que persegue os inimigos transformados em jade
			Cada acerto lança uma maldição de jade: ataques {0}% mais lentos por acúmulo
			Com {1} acúmulos o inimigo vira jade por {2} segundos, e depois não pode ser amaldiçoado por {3} segundos
			Chefes e minichefes precisam de {4} acúmulos, e viram jade no máximo {5} vezes por luta
			'''
	}

	DiamondCutter: {
		DisplayName: Cortador de Diamante
		Tooltip:
			'''
			Dispara um feixe de diamante preciso e instantâneo que atravessa até {0} inimigos
			Ignora {1}% da defesa inimiga
			Não usa munição
			'''
	}

	BarrelGun: {
		DisplayName: Arma-Barril
		Tooltip:
			'''
			Arremessa peixes
			{0}% de chance de atordoar um inimigo comum
			Não pode acertar golpes críticos
			Na chuva ou debaixo da água: +{1}% de dano, e os peixes perseguem os inimigos
			'''
	}
}

