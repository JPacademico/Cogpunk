			'''
	}

	TrashTr0mBag: {
		DisplayName: Treasure Bag ({$Mods.Cogpunk.NPCs.TrashTr0m.DisplayName})
		Tooltip: "{$CommonItemTooltip.RightClickToOpen}"
	}

	Tetanus: {
		DisplayName: Tetanus
		Tooltip:
			'''
			A quick thrust that hits on the way out and again on the way back, wherever you aim
			Hold right click to draw it back and charge: +{0}% damage every quarter second, up to +{1}%
			The charged lunge also hits going out and coming back
			Inflicts Tetanus: the target takes {2}% more damage
			'Mind the rust'
			'''
	}

	ScrapLauncher: {
		DisplayName: Scrap Launcher
		Tooltip:
			'''
			Fires chewed scrap that flies straight across the screen
			Right click to lob a big scrap ball that bounces once
			'Open wide'
			'''
	}

	Scrapmancer: {
		DisplayName: Scrapmancer
		Tooltip:
			'''
			Slams a junk shockwave along the ground towards the cursor
