		DisplayName: Possessed Cog
		Tooltip: Grinds through enemies instead of bouncing off them
	}

	PagodaChest: {
		DisplayName: Pagoda Chest
		Tooltip: ''
	}

	PagodaKey: {
		DisplayName: Pagoda Key
		Tooltip: Unlocks the Locked Pagoda Chest at the top of Coghaven's pagoda
	}

	JadeyBag: {
		DisplayName: Treasure Bag ({$Mods.Cogpunk.NPCs.Jadey.DisplayName})
		Tooltip: "{$CommonItemTooltip.RightClickToOpen}"
	}

	JadeShaperPendant: {
		DisplayName: Jade-shaper Pendant
		Tooltip:
			'''
			A blow that would kill you turns you into a jade statue for {0} seconds instead
			The statue takes no damage, but blows still knock it back
			Recharges for {1} minutes after it saves you
			'''
	}

	JadeIncense: {
		DisplayName: Jade Incense
		Tooltip:
			'''
			Burn it inside Coghaven's Jade Vault to call Jadey
			'She never refuses a visitor who brings incense'
			'''
	}

	JadeShaperWhip: {
		DisplayName: Jade-shaper Whip
		Tooltip:
			'''
			{0} summon tag damage
			Your summons will focus struck enemies
			Deals {1}% more damage to enemies turned to jade
			'''
	}

	JadeCursedGlaives: {
		DisplayName: Jade Cursed Glaives
		Tooltip:
			'''
			Crossing slashes cut one wide jade arc and lay the jade curse on what they cut
			Right click to throw the glaive up to {0} tiles for {2} steam; it comes back to your hand
			Slashes and throws deal {1}% more damage to enemies turned to jade
			'''
	}

	FireworkCannon: {
		DisplayName: Firework Cannon
		Tooltip:
			'''
			Fires quick fireworks that burst on impact, against walls or after {0} tiles
			The burst hurts everything around it and has a {1}% chance to stun common enemies for {2} second
			'''
	}

	JadeShaperManual: {
		DisplayName: Jade-shaper Manual
		Tooltip:
			'''
			Jadey's notes on shaping living jade
			Study it to keep its knowledge
			'Some crafts can only be learned, never found'
			'''
	}

	ScrapManual: {
		DisplayName: Scrap Manual
		Tooltip:
			'''
			Trash-Tr0m's greasy assembly notes
			Study it to keep its knowledge
			'Some crafts can only be learned, never found'
			'''
	}

	SheriffsLawBook: {
		DisplayName: Sheriff's Law Book
		Tooltip:
			'''
			The Cursed Conductor's book of old Westworld law
			Study it to keep its knowledge
			'Some crafts can only be learned, never found'
			'''
	}

	StickyPages: {
		DisplayName: Sticky Pages
		Tooltip:
			'''
			Pages pulled out of the Tar Tyrant, still legible
			Study them to keep their knowledge
			'Some crafts can only be learned, never found'
			'''
	}

	JadeEyedKoi: {
		DisplayName: Jade-eyed Koi
		Tooltip:
			'''
			A koi cast in gold, with eyes of polished jade
			'Worth a fortune to the right merchant'
			'''
	}

	Cakti: {
		DisplayName: Cak-ti
		Tooltip:
			'''
			Fires thin cactus spikes that stick in enemies for {0} seconds
			When a spiked enemy dies, its spikes fly out in every direction
			{1}% chance not to consume ammo
			'Don't hug it'
			'''
	}

	IncenseMace: {
		DisplayName: Incense Mace
		Tooltip:
			'''
			Hold to spin the censer, release to throw it: thrown, it hits twice as hard
			Right click to fan out an incense aura ({4} steam): allies within {0} tiles get +{1}% damage and attack speed for {2} seconds
			Then the censer needs {3} seconds to rekindle
			'It smells like a temple and hits like a bell'
			'''
	}

	JadeToken: {
		DisplayName: Jade Token
		Tooltip:
			'''
			Summons a jade spirit fox
			'It glows softly'
			'''
	}

	AncientResearchBook: {
		DisplayName: Ancient Research Book
		Tooltip:
			'''
			Used to build an Ancient Research Table
			'Its eye seems to follow you'
			'''
	}

	AncientResearchTable: {
		DisplayName: Ancient Research Table
		Tooltip:
			'''
			Right click to research: spend knowledge points on lasting bonuses and new recipes
			Knowledge comes from your firsts: bosses, events, discoveries
			'''
	}

	TetanusShot: {
		DisplayName: Tetanus Shot
		Tooltip:
			'''
			Grants immunity to Tetanus
			'Just a little sting'
			'''
	}

	BundleOfWands: {
		DisplayName: Bundle of Wands
		Tooltip:
			'''
			Fires five different gem bolts at once
			Each flies, hits and pushes like its own staff's
			'''
	}

	BanditsDream: {
		DisplayName: Bandit's Dream
		Tooltip:
			'''
			Fires a fast brass bullet that ricochets once off a wall, towards the nearest foe in sight
			A ricochet hits for 50% more damage
			Uses bullets: whatever the bullet, it fires its own brass round with the bullet's damage added
			Holds {0} rounds and takes {1} seconds to reload once they are spent (the Sheriff's Revolver's cylinder)
			Right click to slash in front for {2}x damage, cutting enemy projectiles down, for {3} steam: it works mid-reload
			'Every outlaw's dream: never run out of bullets'
			'''
	}
	CogspringSword: {
		DisplayName: Cogspring Sword
		Tooltip:
			'''
			Swing it like a sabre: every slash comes back the other way
			Hold right click to wind the spring: up to {0} seconds for up to {1}x damage, then let go to slam it down ({2} steam)
			A fully charged slam that kills an enemy slows time
			'Every cog wound tight, every tooth sharp'
			'''
	}
	SmokerBook: {
		DisplayName: Smoker Book
		Tooltip:
			'''
			Sends a rushing band of soot {0} tiles out
			The smoke runs through every enemy in its path
			'Its pages have never once been read without coughing'
			'''
	}
	FungimancerBag: {
		DisplayName: Treasure Bag (Fungimancer)
		Tooltip: "{$CommonItemTooltip.RightClickToOpen}"
	}

	RainbowMushroom: {
		DisplayName: Rainbow Mushroom
		Tooltip:
			'''
			Summons the Fungimancer
			Only works in a glowing mushroom biome
			'It tastes like every colour at once'
			'''
	}

	FungiManual: {
		DisplayName: Fungi Manual
		Tooltip:
			'''
			The Fungimancer's soggy notes on mushroom magic
			Study it to keep its knowledge
			'Some crafts can only be learned, never found'
			'''
	}

	JadeRefractor: {
		DisplayName: Jade Refractor
		Tooltip:
			'''
			Hold to keep a thin jade laser on the cursor that cuts the first {0} enemies it meets
			Ignores {1}% of enemy defense and lays the jade curse
			Deals {2}% more damage to enemies turned to jade
			'''
	}

	JadeClaws: {
		DisplayName: Jade Claws
		Tooltip: "'Crystal talons on a lacquered gauntlet: they part rock and flesh alike'"
	}

	MissingBones: {
		DisplayName: Missing Bones
		Tooltip:
			'''
			Summons a raptor skeleton to ride: fast, and its rider can't catch the Tar Plague
			Bones don't float: it sinks in liquids and paddles up while you hold jump
			'''
	}

	BlueStarFruit: {
		DisplayName: Blue Star Fruit
		Tooltip:
			'''
			+3% magic damage and critical strike chance, +3% mana regeneration, -3% mana cost and +20 maximum mana for {0} minutes
			One proper meal at a time
			'''
	}

	FishOnASpear: {
		DisplayName: Fish on a Spear
		Tooltip:
			'''
			+3% melee damage, critical strike chance, melee speed and knockback and +20 maximum life for {0} minutes
			One proper meal at a time
			'''
	}

	DeadeyeChili: {
		DisplayName: Deadeye Chili
		Tooltip:
			'''
			+3% ranged damage, critical strike chance and attack speed, a 3% chance not to use ammo and +20 maximum life for {0} minutes
			One proper meal at a time
			'''
	}

	FireflyJelly: {
		DisplayName: Firefly Jelly
		Tooltip:
			'''
			+3% summon damage, whip speed, whip range and minion knockback and +20 maximum life for {0} minutes
			One proper meal at a time
			'''
	}

	RainbowRobe: {
		DisplayName: Rainbow Robe
		Tooltip:
			'''
			Increases maximum mana by {0}
			Reduces mana cost by {1}%
			{2}% increased magic damage
			Gem staffs and other gem magic weapons fire one more projectile at no extra mana
			'''
	}

	JadeCoin: {
		DisplayName: Jade Coin
		Tooltip:
			'''
			Summons a jade bat to fight for you
			Using it again makes the spirit grow instead: a jade beetle, a jade golem, then a jade loong
			Once it is a loong, the next use calls a new bat
			'''
	}
	DemonTable: {
		DisplayName: "Demon Table"
		Tooltip: "Counts as a demon altar for crafting\nIt never spreads, and townsfolk don't mind it"
	}
	Tearstone: {
		DisplayName: "Tearstone"
		Tooltip: "{0} defense while at full health"
	}
}

Buffs: {
	ScrappybotBuff: {
		DisplayName: Scrappybot
		Description: A rusty little robot is following you
	}

	MiceBotBuff: {
		DisplayName: Mice-bot
		Description: A clockwork mouse is biting your enemies
	}

	TarPlague: {
		DisplayName: Tar Plague
		Description: Steaming tar is eating through you. Get out!
	}

	RedClothCooldown: {
		DisplayName: Folding the Cloth
		Description: Your Red Cloth can't dodge again yet
	}

	TetanusDebuff: {
		DisplayName: Tetanus
		Description: Taking 10% more damage
	}

	Overheat: {
		DisplayName: Overheated
		Description: Your boiler is venting! No items, and you can't stop moving until your steam refills
	}

	AlarmoboBuff: {
		DisplayName: Alarmobô
		Description: "{0} Alarmobô in range: +{1}% movement speed, +{2}% attack speed"
	}

	TarSlimeBuff: {
		DisplayName: Tar Slime
		Description: A tar slime is spitting at your enemies
	}

	WrenchRiposteBuff: {
		DisplayName: Riposte
		Description: Your next Metal Wrench swing deals {0}x damage
	}

	WrenchParryCooldown: {
		DisplayName: Wrench Recovering
		Description: You can't parry again yet ({0} seconds after a parry)
	}

	TarWhipDebuff: {
		DisplayName: Tar-Whipped
		Description: Summons deal more damage to this enemy
	}

	SheriffStarBuff: {
		DisplayName: Sheriff Stars
		Description: The law rides over your head
	}

	ConductorCurse: {
		DisplayName: Conductor's Curse
		Description: You take 25% more damage from the ghost train and its ghosts
	}

	GhostTrainBuff: {
		DisplayName: Ghost Train
		Description: A little ghost train runs with you
	}

	JadeCurse: {
		DisplayName: Jade Curse
		Description: "{0}% slower attacks per stack; turns to jade at {1} stacks"
	}

	JadePetrified: {
		DisplayName: Petrified in Jade
		Description: Frozen in jade: no moving, no attacking
	}

	JadeWard: {
		DisplayName: Jade Ward
		Description: The jade curse can't take hold again yet
	}

	Stunned: {
		DisplayName: Stunned
		Description: Seeing stars
	}

	SteamInjection: {
		DisplayName: Steam Injection
		Description:
			'''
			+{0} maximum steam, {1}% less steam cost
			Lasts until you die
			'''
	}

	JadeStatue: {
		DisplayName: Jade Statue
		Description: Turned to jade: nothing can hurt you
	}

	JadeShaperRest: {
		DisplayName: Jade-shaper's Rest
		Description: Your pendant can't save you again yet
	}

	JadeShaperWhipDebuff: {
		DisplayName: Jade Mark
		Description: Summons deal more damage to it
	}

	IncenseBlessing: {
		DisplayName: Incense Blessing
		Description: "+{0}% damage and +{1}% attack speed"
	}

	IncenseBurntOut: {
		DisplayName: Burnt-out Censer
		Description: "The Incense Mace's censer is rekindling ({0} seconds in all)"
	}

	JadeFoxBuff: {
		DisplayName: Jade Spirit Fox
		Description: A small fox of jade light follows you
	}

	ResearchSlimed: {
		DisplayName: Slimed
		Description: Sticky and slow
	}

	MissingBonesBuff: {
		DisplayName: Missing Bones
		Description: A rebuilt raptor carries you, and the tar can't touch you
	}

	BlueStarFruitBuff: {
		DisplayName: Starlit Belly
		Description: Small boosts to magic and mana
	}

	FishOnASpearBuff: {
		DisplayName: Spearfisher's Vigor
		Description: Small boosts to melee and life
	}

	DeadeyeChiliBuff: {
		DisplayName: Deadeye Heat
		Description: Small boosts to ranged attacks and life
	}

	FireflyJellyBuff: {
		DisplayName: Firefly Glow
		Description: Small boosts to summoning and life
	}

	JadeCoinBuff: {
		DisplayName: Jade Spirits
		Description: Jade spirits fight for you, and grow each time you call them
	}
	Polymorphed: {
		DisplayName: "Polymorphed"
		Description: "You are a toadstool: you can only hop around\nOther players can hurt you"
	}
	ShellShocked: {
		DisplayName: "Shell-Shocked"
		Description: "Your ears are ringing and you can't move"
	}
}

NPCs: {
	TrashTr0m: {
		DisplayName: Trash-Tr0m
		Epithet: Colossus of the Scrapheap
		Bestiary: The top half of a construction titan, torn off at the waist and welded back together from whatever the Junkyard had. It drags itself after anything that moves, slams the ground hard enough to make it ripple, and inhales whatever it cannot catch. It sleeps under the scrap, guarding a cache it can no longer open: it swallowed the key long ago.
		CacheGuarded: The cache won't budge. Something is still guarding it...
		KeyDropped: A chewed-up key clatters out of the wreck...
		CacheLocked: The cache is locked tight. Trash-Tr0m's Lost Key opens it.
	}

	DeliveryDrone: {
		DisplayName: Delivery Drone
		Bestiary: A delivery drone that lost its route and found a new trade. It circles anything left lying on the ground, scans it for five long seconds and flies off with it in its claw. It is all cardboard and bluster: shoot it down and whatever it took falls back out.
	}

	RustCollector: {
		DisplayName: Rust Collector
		Bestiary: A scrap bin on two rollers that never stopped doing its job. It charges at anything that might be rust, and it thinks everything might be rust. It cannot climb, but it never stops accelerating.
	}

	Trapper: {
		DisplayName: Trapper
		Bestiary: Half goblin, half clockwork, all hunter. It bolted a brass arm and a lens eye onto itself and took to the jungle with a sack of spike balls. It never lets its prey get close: it runs, turns, and seeds the ground with spikes.
	}

	LivingTar: {
		DisplayName: Living Tar
		Bestiary: Tar from the Junkyard pool that crawled out on its own. It hops like any slime, and every landing flings a hot glob of itself at whoever it is chasing.
	}

	RogueMiceBot: {
		DisplayName: Rogue Mice-bot
		Bestiary: A clockwork mouse that slipped its winding key and never came back. The Mech Army winds them up by the dozen; they race in faster than you can walk and pounce with their steel teeth bared.
	}

	Boombot: {
		DisplayName: Boombot
		Bestiary: A bomb with legs and one job. It beeps faster the closer it gets, and the moment it touches you it goes off. Shot down first, it only fizzles.
	}

	AnnoyOTron: {
		DisplayName: Annoy-o-tron
		Bestiary: An alarm box on treads with a spinning emergency beacon for a head. It never fights. It follows the army around, screaming, and every machine that hears it moves half again as fast.
	}

	Jaeger: {
		DisplayName: Jaeger
		Bestiary: The Mech Army's walking fortress, six times taller than a person and armoured like a boiler. It marches slowly and never stops, and whatever it walks into is thrown across the field. It only takes the field once the battle is half won.
	}

	TarTyrant: {
		DisplayName: Tar Tyrant
		Epithet: Monarch of the Mire
		Bestiary: The Junkyard's tar pool is older than the Junkyard. Something enormous drowned in it long ago, and the tar kept its bones and learned to move them. It wears the old skull as a face, flings its own bones at whatever comes near, and every wound it takes sheds tar that crawls off on its own. Only a worm made of scrap is tempting enough to fish it out.
	}

	TarTyrantBubble: {
		DisplayName: Tar Bubble
	}

	ScrapwormCritter: {
		DisplayName: Scrapworm
		Bestiary: A worm that ate so much buried scrap it turned into scrap itself. It is harmless and rare, and something in the Junkyard's tar would very much like to eat it.
	}

	PuxaFrango: {
		DisplayName: Puxa-frango
		Bestiary: A hunched, creaking machine that stalks the caves on spindly legs. It used to guard a henhouse; now it guards nothing and grabs everything. When its claws open wide, it is about to lunge, and it pulls whatever it catches in close.
	}

	Coghawk: {
		DisplayName: Coghawk
		Bestiary: A hawk of brass and riveted iron, wound up round the cog in its chest. It circles high over the dunes until it has picked its prey, screeches once, and drops into a swoop that skims the sand. Whatever stays on the ground gets the talons.
	}

	Splasher: {
		DisplayName: Splasher
		Bestiary: A boiler robot that rusts if it so much as looks at a cloud, so somebody bolted an umbrella to its head. It only comes out in the rain, keeps its distance, pumps its water gun and soaks whoever is out in the storm with it.
	}

	BeatBoxer: {
		DisplayName: Beat-Boxer
		Bestiary: A sparring robot wired to a jukebox, still waiting for the next bout in the halls of the Dungeon. It keeps time on the speakers bolted to its shoulders and throws its spring-loaded gloves in pairs, one-two, hard enough to send you flying.
	}

	Friendobo: {
		DisplayName: Last Ghedalari
		Bestiary: The last of the Ghedalari, an ancient people the world has all but forgotten. Tall and blue-skinned, with long swept-back ears, eyes that glow without pupils and hooves on legs bent backwards, he still wears his people's gold and carries their spear. He moved in once the Mech Army stopped marching, and he trades in scrap and in the trinkets that wake the great beasts.
	}

	Cogtuna: {
		DisplayName: Cogtuna
		Bestiary: A great tuna of riveted iron that never has to surface: a boiler breathes for it, and the furnace in its throat glows whenever it opens its jaws. Its plates turn most blades aside, it hits like a dropped anchor, and it will not leave the water to chase you.
	}

	BrassBandit: {
		DisplayName: Brass Bandit
		Bestiary: An outlaw robot of dusty brass that still holds up the streets of Westworld. It shoots on sight, fans all six chambers of its rusty revolver, then turns tail and runs to reload. Even a bandit knows when it is out of bullets.
	}

	Sheriff: {
		DisplayName: Sheriff
		Bestiary: The last lawman of Westworld, still keeping the peace long after the townsfolk left. Three sheriff stars ride over his hat; he throws them one at a time at whoever breaks the law, and the ones that miss bite into the walls until he calls them home, straight through anyone in the way. His revolver is the only clean thing left in town. He never runs, not even to reload.
	}

	MechanicalBull: {
		DisplayName: Mechanical Bull
		Bestiary: A steam rodeo bull that threw its last rider decades ago and never stopped bucking. When it lowers its horns and paws the ground, get out of the way: once it starts its charge it does not turn.
	}

	Dinamitrom: {
		DisplayName: Dinamitrom
		Bestiary: A powder keg that somebody gave legs. It hops around the old mine with its fuse lit, and when it spots you it crouches and leaps. Shoot it before it lands.
	}

	CursedConductor: {
		DisplayName: Cursed Conductor
		Epithet: The Last Stop
		Bestiary: The conductor of the line that once ran under Westworld, still keeping time for a train that left the rails a hundred years ago. The crash took his legs and the curse took the rest; a turbine bolted where his legs were pumps soot to keep him aloft, and his whistle still calls the train, and the train still comes. Leave his town and he will chase you to the end of the line.
	}

	ConductorGhost: {
		DisplayName: Cursed Ghost
	}

	JadeGolem: {
		DisplayName: Jade Golem
		Bestiary: A statue carved from a single block of jade and woken by the bronze heart set in its chest. It walks slowly and hits like a landslide; when it stops and raises its fist, the light gathering there aims where you stood a moment ago. Keep moving, and move again when the line blinks.
	}
	RhinoBeetle: {
		DisplayName: Rhino Beetle
		Bestiary: A giant rhinoceros beetle of the deep jungle, rarely seen and heavily armoured, spores glowing in the veins of its shell. When it lowers its horn and scrapes the ground it will charge, and whatever its horn catches it hurls away and up into the air. Climbing out of reach will not save you: it can fly.
	}

	DragoneteMiudo: {
		DisplayName: Dragonete Miúdo
		Bestiary: A baby dragon of the Underworld, still more head than wings. It keeps its distance and spits bolts of fire, and if one misses it loses its temper and comes flying in to bite. Its bite is worse than its bark.
	}

	Cogscorpion: {
		DisplayName: Cogscorpion
		Bestiary: "A palace guardian built like a scorpion, its bronze plates edged in red lacquer and its jade sting glowing over its back. It runs down intruders and rams them with its claws and bulk."
	}

	FlyingBuddhaHead: {
		DisplayName: Flying Buddha Head
		Bestiary: The head of a great golden statue, cut from its body and kept aloft by Coghaven's machinery, its halo still turning. It drifts after intruders in perfect calm and never strikes in passing. When its eyes open, it drops like a temple bell, and needs a moment to collect itself.
	}
	Mechromancer: {
		DisplayName: Mechromancer
		Bestiary: A robot necromancer that only walks the earth under a blood-red moon, though it has no legs to walk with. A brass skull grins out of the shadow of its horned hood, its claws burn with soul fire, and its mechanical eyes drift around it, never once looking away from you. Where it points, the ground opens and the dead climb out.
	}

	Jadey: {
		DisplayName: Jadey
		Epithet: A Molda-Jade
		Bestiary: The palace's jademancer, a panda who shapes living jade the way a potter shapes clay. She guards the vault under the Main Hall and never touches an intruder herself: she tosses jade coins that hatch golems, bats and beetles, whirls a rope dart that curses the floor where it lands, and drinks her own creations back to mend herself. Her jade curses everyone but her, and each time a fifth of her life is gone she hatches a brood and hides inside a shell of jade until they fall or she can drink them.
		VaultGuarded: The vault stirs. Its keeper has noticed you...
		VaultOpens: The seal on the Jade Vault crumbles.
	}

	JadeBat: {
		DisplayName: Jade Bat
		Bestiary: A bat hatched from one of Jadey's coins: thin wings of cut jade round a spark of her will. Its bite carries her curse, and it crumbles the moment she is gone.
	}

	JadeBeetle: {
		DisplayName: Jade Beetle
		Bestiary: A rhino beetle copied in jade from one of Jadey's coins. Smaller and more brittle than the jungle's own, but its horn still throws whatever it catches, and it leaves her curse behind.
	}
	Fungimancer: {
		DisplayName: "Fungimancer"
		Epithet: "The Spore-Addled Sage"
		Bestiary: "A frog who sat on a glowing mushroom so long that the mushroom's magic soaked into it, and very little else did. Mushrooms rain wherever it looks, rainbow light cuts the air, and a burp from it can turn you into a toad. When it raises both hands, break what grows between them, or cover your ears. It only wakes when someone breaks the rarest mushroom of all: the rainbow-capped one."
	}
	Toadstool: {
		DisplayName: "Toadstool"
		Bestiary: "A warty toad of the glowing mushroom fields that grows a garden on its back. It leaps at whatever moves, and its spores leave the mind spinning; it bursts into a cloud of them when it dies."
	}
	CrystalLizard: {
		DisplayName: "Crystal Lizard"
		Bestiary: "A timid lizard of the deep caves, armoured in living crystal. Startle it and it bolts; give it five heartbeats and it is gone into the rock, along with everything it has been hoarding."
	}
	Driller: {
		DisplayName: "Driller"
		Bestiary: "A mining bot that never stopped digging. It rolls after anything that moves, and when a wall or a ledge is in the way it simply goes through."
	}
	FloatyMushroom: {
		DisplayName: "Drifting Mushroom"
	}
	OrbitMushroom: {
		DisplayName: "Toadstool Egg"
	}
	ChannelMushroom: {
		DisplayName: "Rainbow Mushroom"
	}
}

Junkyard: {
	TarDeath: "{0} sank into the tar."
}

