	AlarmHead: {
		DisplayName: Alarm Head
		Tooltip:
			'''
			Summons an Alarmobô that follows you and never stops ringing
			Every player within {2} tiles of it gets {0}% movement speed and {1}% attack speed
			Several Alarmobôs stack
			'It only ever wanted to warn someone'
			'''
	}

	CogpunkerManual: {
		DisplayName: Cogpunker Manual
		Tooltip:
			'''
			Permanently increases maximum steam by {0}
			Teaches the steam dash: a burst of steam that projectiles pass through
			Costs {1} steam, ready again after {2} seconds. Double tap left or right, or use the key below
			Enemies you dash into still hit you
			Can only be read once per character
			'''
		Learned: Steam dash learned!
		AlreadyRead: You have already read this manual
		DashKey: "Steam dash key: {0}"
		DashKeyUnbound: unbound (set it in Controls)
	}

	JaegerHelmet: {
		DisplayName: Jaeger Helmet
		Tooltip:
			'''
			{0}% increased melee damage
