# English (source of truth). tModLoader adds keys for new content here automatically;
# mirror every new key into pt-BR_Mods.Cogpunk.hjson in the same change.

Configs: {
	CogpunkClientConfig: {
		DisplayName: Cogpunk: Client Settings

		Headers: {
			Visuals: Visuals
		}

		ScreenShake: {
			Label: Screen shake
			Tooltip: Camera shake from explosions, bosses and heavy weapons.
		}

		EffectDensity: {
			Label: Effect density
			Tooltip: Amount of optional steam, spark and smoke particles. Lower it if you get frame drops.
		}

		ReduceFlashing: {
			Label: Reduce flashing
			Tooltip: Tones down bright flashes and strobing effects.
		}
	}
}

Items: {
	RustedScrap: {
		DisplayName: Rusted Scrap
		Tooltip: Compacted junk. Something useful might still be buried inside.
	}

	RustedCog: {
		DisplayName: Rusted Cog
		Tooltip: Eaten by rust, but it still wants to turn.
	}

	RustedMetal: {
		DisplayName: Rusted Metal
		Tooltip: A torn, riveted plate. Good metal under the rust.
	}

	Scrappybot: {
		DisplayName: Scrappybot
		Tooltip: Summons Scrappybot, a rusty little robot that powers down to recharge
	}

	ScrapBomb: {
		DisplayName: Scrap Bomb
		Tooltip:
			'''
			Explodes on impact, dealing {0} blast damage in a {1} tile radius
			A direct hit deals its full damage plus the blast
			Does not destroy tiles
			'''
	}

	ScrapHelmet: {
		DisplayName: Scrap Helmet
		Tooltip:
			'''
			Displays the most valuable ore around you
			A dented pot with a goggle bolted on. The cog still turns.
			'''
		SetBonus:
			'''
			{0}% increased movement speed
			While moving, lobs a bouncing cog every {1} seconds ({2} damage)
			It flies at the nearest enemy, or out behind you when none is near
			'''
	}

	ScrapBreastplate: {
		DisplayName: Scrap Breastplate
		Tooltip:
			'''
			{0}% increased damage
			Riveted together from whatever the heap gave up
			'''
	}

	ScrapLeggings: {
		DisplayName: Scrap Leggings
		Tooltip:
			'''
			{0}% reduced fall damage
			Rusty, but there's still a spring in them
			'''
	}

	PolishedMetal: {
		DisplayName: Polished Metal
		Tooltip: Welded, patched-up plating. Too hard for most pickaxes.
	}

	ScrappyTrunk: {
		DisplayName: Scrappy Trunk
		Tooltip: ""
	}

	Junkbait: {
		DisplayName: Junkbait
		Tooltip:
			'''
			A greasy ball of scrap with a little robot rattling inside
			Use in the Junkyard to lure out Trash-Tr0m
			'''
	}

	LostKey: {
		DisplayName: Lost Key
		Tooltip:
			'''
			Opens the Junkyard Cache
			'It has been chewed on'
			'''
	}

	Screwdriver: {
		DisplayName: Screwdriver
		Tooltip:
			'''
			Hits on the thrust and again on the way back
			{0}% more damage to mechanical enemies
			'Righty-tighty, lefty-loosey, stabby-stabby'
			'''
	}

	ScrappyWand: {
		DisplayName: Scrappy Wand
		Tooltip:
			'''
			Fires a burst of {0} sparks
			Only the first one goes where you aim
			'''
	}

	ScrappyBow: {
		DisplayName: Scrappy Bow
		Tooltip:
			'''
			Looses {0} to {1} arrows for the price of one
			Only the first arrow flies true
			'''
	}

	MiceBot: {
		DisplayName: Mice-bot
		Tooltip:
			'''
			Summons a clockwork mouse to fight for you
			Takes half a minion slot
			Digs through thin walls and floors to reach enemies
			'Wind it up and let it go'
			'''
	}

	TrashTr0mBag: {
		DisplayName: Treasure Bag ({$Mods.Cogpunk.NPCs.TrashTr0m.DisplayName})
		Tooltip: "{$CommonItemTooltip.RightClickToOpen}"
	}

	Tetanus: {
		DisplayName: Tetanus
		Tooltip:
			'''
			A quick thrust that hits on the way out and again on the way back, wherever you aim
			Hold right click to draw it back and charge: +{0}% damage every half second, up to +{1}%
			The charged lunge also hits going out and coming back
			Inflicts Tetanus: the target takes {2}% more damage
			'Mind the rust'
			'''
	}

	ScrapLauncher: {
		DisplayName: Scrap Launcher
		Tooltip:
			'''
			Uses bullets as ammo, but fires chewed scrap that flies straight across the screen
			Right click to lob a big scrap ball that bounces once
			'Open wide'
			'''
	}

	Scrapmancer: {
		DisplayName: Scrapmancer
		Tooltip:
			'''
			Slams a junk shockwave along the ground towards the cursor
			It rolls a whole screen, pierces every enemy and knocks them flying
			Needs ground beneath you
			'''
	}

	Tr0mheadStaff: {
		DisplayName: Tr0mhead
		Tooltip:
			'''
			Summons a Tr0mhead sentry that inhales nearby enemies and chews them
			Sucks for up to {0} seconds, then vents steam for {1} seconds
			'It's still hungry'
			'''
	}

	PolisherSchematic: {
		DisplayName: Polisher Schematic
		Tooltip:
			'''
			Lets you build a Rust Polisher at an anvil
			Not consumed
			'Most of the instructions are grease stains'
			'''
	}

	RustPolisher: {
		DisplayName: Rust Polisher
		Tooltip: Used to polish rusted metal and to craft Polished armor and Brass Containers
	}

	MysteriousMap: {
		DisplayName: Mysterious Map
		Tooltip:
			'''
			While held, an arrow points the way to something hidden in this world
			'The ink is still wet'
			'''
	}

	TarDrop: {
		DisplayName: Tar Drop
		Tooltip: A glob of the Junkyard's tar. Still warm.
	}

	CondensedTar: {
		DisplayName: Condensed Tar
		Tooltip: Four drops of tar, boiled down until they hold their shape.
	}

	PolishedHelmet: {
		DisplayName: Polished Helmet
		Tooltip:
			'''
			{0}% increased mechanist critical strike chance
			A buffed-up boiler cap with a pressure gauge for a crest
			'''
		SetBonus: Mechanist weapons use {0}% less steam
	}

	PolishedChestplate: {
		DisplayName: Polished Chestplate
		Tooltip:
			'''
			Increases maximum steam by {0}
			A little boiler rides on the back
			'''
	}

	PolishedPants: {
		DisplayName: Polished Pants
		Tooltip:
			'''
			{0}% increased movement speed
			Piston knees, freshly greased
			'''
	}

	TrapperChain: {
		DisplayName: Trapper Chain
		Tooltip:
			'''
			Flings a bear trap on a chain that bites every enemy caught in its jaws
			Ready to throw again as soon as the trap is back
			'Still smells like the jungle'
			'''
	}

	GlassContainer: {
		DisplayName: Glass Container
		Tooltip:
			'''
			Increases maximum steam by {0}
			Only one steam container can be worn
			'Handle with care'
			'''
	}

	BrassContainer: {
		DisplayName: Brass Container
		Tooltip:
			'''
			Increases maximum steam by {0}
			{1}% increased mechanist damage
			Only one steam container can be worn
			'''
	}

	AlarmHead: {
		DisplayName: Alarm Head
		Tooltip:
			'''
			Summons an Alarmobô that follows you and never stops ringing
			Every player within {2} tiles of it gets {0}% movement speed and {1}% attack speed
			Several Alarmobôs stack
			'It only ever wanted to warn someone'
			'''
	}

	CogpunkerManual: {
		DisplayName: Cogpunker Manual
		Tooltip:
			'''
			Permanently increases maximum steam by {0}
			Teaches the steam dash: a burst of steam that projectiles pass through
			Costs {1} steam, ready again after {2} seconds. Double tap left or right, or use the key below
			Enemies you dash into still hit you
			Can only be read once per character
			'''
		Learned: Steam dash learned!
		AlreadyRead: You have already read this manual
		DashKey: "Steam dash key: {0}"
		DashKeyUnbound: unbound (set it in Controls)
	}

	JaegerHelmet: {
		DisplayName: Jaeger Helmet
		Tooltip:
			'''
			{0}% increased melee damage
			The visor still glows
			'''
		SetBonus:
			'''
			Immune to knockback and {0}% increased knockback
			Enemies you touch take {1} melee damage
			{2}% reduced movement speed
			'''
	}

	JaegerChestplate: {
		DisplayName: Jaeger Chestplate
		Tooltip:
			'''
			{0}% less damage taken from touching enemies
			The reactor is still warm
			'''
	}

	JaegerGreaves: {
		DisplayName: Jaeger Greaves
		Tooltip:
			'''
			Increased jump height
			{0}% increased melee critical strike chance
			'''
	}

	PolishedCog: {
		DisplayName: Polished Cog
		Tooltip:
			'''
			{0}% increased movement speed while overheated
			'Rust buffed off, teeth sharpened: it spins faster when the boiler blows'
			'''
	}

	ChickenSnapper: {
		DisplayName: Chicken Snapper
		Tooltip:
			'''
			{0}% increased melee critical strike chance
			{1}% increased melee speed
			'It still twitches shut when something feathery walks by'
			'''
	}

	Scrapworm: {
		DisplayName: Scrapworm
		Tooltip:
			'''
			Use it as fishing bait in the Junkyard's tar...
			Nothing else will bite it
			'''
	}

	TarTyrantBag: {
		DisplayName: Treasure Bag ({$Mods.Cogpunk.NPCs.TarTyrant.DisplayName})
		Tooltip: "{$CommonItemTooltip.RightClickToOpen}"
	}

	SereneTear: {
		DisplayName: Serene Tear
		Tooltip:
			'''
			Mana costs are paid with steam first, and with mana once the steam runs out
			Immunity to Overheat
			{0}% increased steam regeneration
			'It fell from no eye. The tar wept it'
			'''
	}

	TyrantSkull: {
		DisplayName: Tyrant Skull
		Tooltip:
			'''
			{0}% increased magic damage
			{1}% increased magic critical strike chance
			'''
		SetBonus:
			'''
			Every {0} seconds a tar claw erupts from the ground under the closest enemy
			The claw deals {1} magic damage to every enemy it catches
			'''
	}

	TyrantCape: {
		DisplayName: Tyrant Cape
		Tooltip:
			'''
			{0}% reduced mana and steam cost
			'Still wet'
			'''
	}

	TyrantSandals: {
		DisplayName: Tyrant Sandals
		Tooltip:
			'''
			{0}% increased movement speed and jump height
			Twice that while out of steam
			'''
	}
}

Buffs: {
	ScrappybotBuff: {
		DisplayName: Scrappybot
		Description: A rusty little robot is following you
	}

	MiceBotBuff: {
		DisplayName: Mice-bot
		Description: A clockwork mouse is biting your enemies
	}

	TarPlague: {
		DisplayName: Tar Plague
		Description: Steaming tar is eating through you. Get out!
	}

	TetanusDebuff: {
		DisplayName: Tetanus
		Description: Taking 10% more damage
	}

	Overheat: {
		DisplayName: Overheated
		Description: Your boiler is venting! No items, and you can't stop moving until your steam refills
	}

	AlarmoboBuff: {
		DisplayName: Alarmobô
		Description: "{0} Alarmobô in range: +{1}% movement speed, +{2}% attack speed"
	}
}

NPCs: {
	TrashTr0m: {
		DisplayName: Trash-Tr0m
		Epithet: Colossus of the Scrapheap
		Bestiary: The top half of a construction titan, torn off at the waist and welded back together from whatever the Junkyard had. It drags itself after anything that moves, slams the ground hard enough to make it ripple, and inhales whatever it cannot catch. It sleeps under the scrap, guarding a cache it can no longer open: it swallowed the key long ago.
		CacheGuarded: The cache won't budge. Something is still guarding it...
		KeyDropped: A chewed-up key clatters out of the wreck...
		CacheLocked: The cache is locked tight. Trash-Tr0m's Lost Key opens it.
	}

	RustCollector: {
		DisplayName: Rust Collector
		Bestiary: A scrap bin on two rollers that never stopped doing its job. It charges at anything that might be rust, and it thinks everything might be rust. It cannot climb, but it never stops accelerating.
	}

	Trapper: {
		DisplayName: Trapper
		Bestiary: Half goblin, half clockwork, all hunter. It bolted a brass arm and a lens eye onto itself and took to the jungle with a sack of spike balls. It never lets its prey get close: it runs, turns, and seeds the ground with spikes.
	}

	LivingTar: {
		DisplayName: Living Tar
		Bestiary: Tar from the Junkyard pool that crawled out on its own. It hops like any slime, and every landing flings a hot glob of itself at whoever it is chasing.
	}

	RogueMiceBot: {
		DisplayName: Rogue Mice-bot
		Bestiary: A clockwork mouse that slipped its winding key and never came back. The Mech Army winds them up by the dozen; they race in faster than you can walk and pounce with their steel teeth bared.
	}

	Boombot: {
		DisplayName: Boombot
		Bestiary: A bomb with legs and one job. It beeps faster the closer it gets, and the moment it touches you it goes off. Shot down first, it only fizzles.
	}

	AnnoyOTron: {
		DisplayName: Annoy-o-tron
		Bestiary: An alarm box on treads with a spinning emergency beacon for a head. It never fights. It follows the army around, screaming, and every machine that hears it moves half again as fast.
	}

	Jaeger: {
		DisplayName: Jaeger
		Bestiary: The Mech Army's walking fortress, six times taller than a person and armoured like a boiler. It marches slowly and never stops, and whatever it walks into is thrown across the field. It only takes the field once the battle is half won.
	}

	TarTyrant: {
		DisplayName: Tar Tyrant
		Epithet: Monarch of the Mire
		Bestiary: The Junkyard's tar pool is older than the Junkyard. Something enormous drowned in it long ago, and the tar kept its bones and learned to move them. It wears the old skull as a face, flings its own bones at whatever comes near, and every wound it takes sheds tar that crawls off on its own. Only a worm made of scrap is tempting enough to fish it out.
	}

	TarTyrantBubble: {
		DisplayName: Tar Bubble
	}

	ScrapwormCritter: {
		DisplayName: Scrapworm
		Bestiary: A worm that ate so much buried scrap it turned into scrap itself. It is harmless and rare, and something in the Junkyard's tar would very much like to eat it.
	}

	PuxaFrango: {
		DisplayName: Puxa-frango
		Bestiary: A hunched, creaking machine that stalks the caves on spindly legs. It used to guard a henhouse; now it guards nothing and grabs everything. When its claws open wide, it is about to lunge, and it pulls whatever it catches in close.
	}
}

