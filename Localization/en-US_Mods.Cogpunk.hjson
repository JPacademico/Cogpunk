		DisplayName: Scrappybot
	}

	ScrapBombProjectile: {
		DisplayName: Scrap Bomb
	}

	ScrapCogProjectile: {
		DisplayName: Scrap Cog
	}

	ScrewdriverProjectile: {
		DisplayName: Screwdriver
	}

	ScrappyWandBolt: {
