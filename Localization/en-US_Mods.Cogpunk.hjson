	MetalWrench: {
		DisplayName: Metal Wrench
		Tooltip:
			'''
			{0}% more damage to mechanical enemies
			Right click to parry for {4} steam: for {1} second, an enemy attack clangs off the wrench and does nothing
			A parry readies a riposte: your next swing deals {3}x damage
			A riposte on a boss or a mini-boss slows down time for a moment
			The parry needs {2} seconds to recover
			'Every problem looks like a loose bolt'
			'''
	}

	Tarmancer: {
		DisplayName: Tarmancer
		Tooltip:
