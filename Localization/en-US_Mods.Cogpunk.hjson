# English (source of truth). tModLoader adds keys for new content here automatically;
# mirror every new key into pt-BR_Mods.Cogpunk.hjson in the same change.

Configs: {
	CogpunkClientConfig: {
		DisplayName: Cogpunk: Client Settings

		Headers: {
			Visuals: Visuals
		}

		ScreenShake: {
			Label: Screen shake
			Tooltip: Camera shake from explosions, bosses and heavy weapons.
		}

		EffectDensity: {
			Label: Effect density
			Tooltip: Amount of optional steam, spark and smoke particles. Lower it if you get frame drops.
		}

		ReduceFlashing: {
			Label: Reduce flashing
			Tooltip: Tones down bright flashes and strobing effects.
		}
	}
}

Items: {
	RustedScrap: {
		DisplayName: Rusted Scrap
		Tooltip: Compacted junk. Something useful might still be buried inside.
	}

	RustedCog: {
		DisplayName: Rusted Cog
		Tooltip: Eaten by rust, but it still wants to turn.
	}

	RustedMetal: {
		DisplayName: Rusted Metal
		Tooltip: A torn, riveted plate. Good metal under the rust.
	}

	Scrappybot: {
		DisplayName: Scrappybot
		Tooltip: Summons Scrappybot, a rusty little robot that powers down to recharge
	}

	ScrapBomb: {
		DisplayName: Scrap Bomb
		Tooltip:
			'''
			Explodes on impact, dealing {0} blast damage in a {1} tile radius
