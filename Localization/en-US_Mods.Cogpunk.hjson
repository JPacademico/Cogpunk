		DisplayName: Tar Drop
		Tooltip: A glob of the Junkyard's tar. Still warm.
	}

	CondensedTar: {
		DisplayName: Condensed Tar
		Tooltip: Four drops of tar, boiled down until they hold their shape.
	}

	PolishedHelmet: {
		DisplayName: Polished Helmet
		Tooltip:
			'''
			{0}% increased mechanist critical strike chance
