Events: {
	MechArmyInvasion: {
		DisplayName: Mech Army
		ApproachingWest: The Mech Army is approaching from the west!
		ApproachingEast: The Mech Army is approaching from the east!
		Arrived: The Mech Army has arrived!
		Defeated: The Mech Army has been defeated!
	}

	Command: {
		Description: Starts, stops, wins or shows the Mech Army invasion (testing)
		ConsoleOnly: In multiplayer, only the server console can use this command.
		Started: The Mech Army has been called.
		CantStart: The Mech Army can't start now: another invasion or event is running.
		Stopped: The Mech Army has been stopped.
		Won: The Mech Army will be defeated next tick.
		NotRunning: The Mech Army isn't running.
		Status: "Mech Army: {0} of {1} left ({2}% cleared)."
	}
}

