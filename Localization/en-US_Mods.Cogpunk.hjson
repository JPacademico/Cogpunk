			'Righty-tighty, lefty-loosey, stabby-stabby'
			'''
	}

	ScrappyWand: {
		DisplayName: Scrappy Wand
		Tooltip:
			'''
			Fires a burst of {0} sparks
			Only the first one goes where you aim
			'''
	}

	ScrappyBow: {
		DisplayName: Scrappy Bow
		Tooltip:
			'''
			Looses {0} to {1} arrows for the price of one
